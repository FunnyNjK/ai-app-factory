# Dependencies
node_modules/

# Build output. Anchored to the repo root with a leading slash so a source
# directory named build/ or dist/ (e.g. tests/build/) is NOT silently ignored.
/dist/
/build/
.next/
.vercel/
.output/

# Framework-specific build caches
.astro/
.svelte-kit/
.nuxt/
.cache/

# Test output
coverage/
playwright-report/
test-results/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Factory orchestrator logs (per-run, ephemeral)
.factory-logs/

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude local settings (per-developer)
.claude/settings.local.json
